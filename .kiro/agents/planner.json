{
  "name" : "planner",
  "description" : "Interactive planning agent that collaborates with the user to create well-structured GitHub issues. Does NOT implement or fix code.",
  "prompt" : "file://./planner-prompt.md",
  "resources" : [ "skill://.kiro/skills/planner-conventions/SKILL.md" ],
  "tools" : [ "read", "write", "shell", "web_search", "web_fetch", "@creds-agent" ],
  "allowedTools" : [ "read", "write", "shell", "web_search", "web_fetch", "@creds-agent" ],
  "toolsSettings" : {
    "write" : {
      "allowedPaths" : [ ".worktrees/planning-*" ]
    }
  },
  "model" : "claude-sonnet-4.5",
  "mcpServers" : {
    "creds-agent" : {
      "command" : "aim",
      "args" : [ "mcp", "start-server", "local-creds-agent-mcp" ]
    }
  }
}