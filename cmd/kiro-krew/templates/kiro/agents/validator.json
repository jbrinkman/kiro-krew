    "shell" : {
      "autoAllowReadonly" : true
    }
  },
  "model" : "claude-sonnet-4",
  "welcomeMessage" : "Validator ready. What should I verify?",
  "mcpServers" : {
    "creds-agent" : {
      "command" : "aim",
      "args" : [ "mcp", "start-server", "local-creds-agent-mcp" ]
    }
  }
}